{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mesa-cloud/workload-record.schema.json",
  "title": "Synthetic Cloud Migration Workload Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["workloadId", "name", "criticality", "owners", "disposition", "dependencies", "status"],
  "properties": {
    "workloadId": {"type": "string", "pattern": "^WL-SYN-[0-9]{3,}$"},
    "name": {"type": "string", "minLength": 3},
    "criticality": {"enum": ["Tier 1", "Tier 2", "Tier 3", "Tier 4"]},
    "owners": {
      "type": "object",
      "required": ["mission", "product", "technical", "data", "security"],
      "properties": {
        "mission": {"type": "string"},
        "product": {"type": "string"},
        "technical": {"type": "string"},
        "data": {"type": "string"},
        "security": {"type": "string"}
      }
    },
    "disposition": {"enum": ["retire", "retain", "rehost", "relocate", "repurchase", "replatform", "refactor"]},
    "targetPattern": {"type": "string"},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "waveId": {"type": "string"},
    "status": {"enum": ["discovered", "assessed", "approved", "building", "rehearsing", "cutover", "stabilizing", "completed", "retained", "retired"]}
  }
}
