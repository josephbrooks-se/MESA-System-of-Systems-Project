{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mesa-cap/security-finding.schema.json",
  "title": "Synthetic Security Finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["findingId", "source", "assetId", "observedAt", "status", "sourceSeverity", "evidenceRefs"],
  "properties": {
    "findingId": {"type": "string", "pattern": "^FND-SYN-[0-9]{3,}$"},
    "source": {"type": "string", "minLength": 2},
    "assetId": {"type": "string", "pattern": "^AST-SYN-[0-9]{3,}$"},
    "configurationId": {"type": "string"},
    "observedAt": {"type": "string", "format": "date-time"},
    "status": {"enum": ["open", "under_review", "mitigated", "accepted_time_bounded", "closed"]},
    "sourceSeverity": {"enum": ["informational", "low", "moderate", "high", "critical"]},
    "missionConsequence": {"enum": ["none", "limited", "significant", "severe", "catastrophic"]},
    "evidenceRefs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "markings": {"type": "array", "items": {"type": "string"}}
  }
}
